# ---- EduCenter OS environment ----
# Server
PORT=3000
NODE_ENV=development

# Database (local dev: embedded-postgres managed by `npm run db:start`)
# Production (Railway): set DATABASE_URL to the Railway PostgreSQL internal URL
DATABASE_URL=postgres://postgres:postgres@localhost:5433/educenter

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# Public registration
PUBLIC_REGISTRATION_ENABLED=true

# Seed (demo data)
SEED_DEMO=true
